{
    "name": "playcanvas-project",
    "version": "0.0.0",
    "private": true,
    "description": "A PlayCanvas TypeScript project",
    "type": "module",
    "scripts": {
        "build": "tsc && vite build",
        "predev": "node ./scripts/ensure-node-version.cjs",
        "dev": "vite",
        "fmt": "prettier --check .",
        "fmt:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "preview": "vite preview"
    },
    "dependencies": {
        "playcanvas": "^2.21.3"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "3.0.0-beta.8",
        "eslint": "^9.39.0",
        "prettier": "^3.9.6",
        "semver": "^7.8.5",
        "typescript": "~6.0.3",
        "vite": "^8.1.5"
    },
    "engines": {
        "node": ">=24.19.0"
    }
}
