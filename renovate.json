{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "rangeStrategy": "bump",
    "packageRules": [
        {
            "matchManagers": ["npm"],
            "groupName": "all npm dependencies",
            "schedule": ["on monday at 10:00am"]
        },
        {
            "matchPackageNames": ["eslint"],
            "allowedVersions": "<10.0.0"
        },
        {
            "description": "Node.js updates are coordinated manually across PlayCanvas packages",
            "matchDepNames": ["node"],
            "enabled": false
        },
        {
            "description": "Node.js types stay on the coordinated LTS major",
            "matchPackageNames": ["@types/node"],
            "allowedVersions": "22.x"
        },
        {
            "description": "typescript-eslint only supports TypeScript <6.1",
            "matchPackageNames": ["typescript"],
            "allowedVersions": "<6.1.0"
        }
    ]
}
